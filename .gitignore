# Controlled documents — NEVER commit (Golden Rule).
# Page images of controlled forms are loaded just-in-time and must stay local.
*.png
*.jpg
*.jpeg
*.gif
*.webp

# Exceptions: suite logo assets (already tracked)
!SitkaTools/sitkablack.png

# This computer's own files (sample DBs with real data, form page images): never committed
local/
Current.json

# Claude Code worktrees (temporary isolated checkouts)
.claude/worktrees/

# Demo databases (built by examples/make-tens-db.js) stay on this computer
examples/*.json
.DS_Store
