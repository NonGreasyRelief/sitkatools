<?xml version="1.0" encoding="utf-8"?>
<!-- The only folders another app may see (SharedFiles): a file being saved through the share sheet, and the camera
     app's picture or video for the page. Each is reached one file at a time, with a grant for that file only. -->
<paths>
    <cache-path name="share" path="share/" />
    <cache-path name="capture" path="capture/" />
</paths>
