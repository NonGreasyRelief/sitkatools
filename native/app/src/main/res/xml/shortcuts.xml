<?xml version="1.0" encoding="utf-8"?>
<!-- Holding the app's icon on the home screen: pick another SitkaTools folder (MainActivity.ACTION_CHANGE_FOLDER) -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="change_folder"
        android:shortcutLongLabel="@string/change_folder_long"
        android:shortcutShortLabel="@string/change_folder_short">
        <intent
            android:action="com.sitkatools.app.CHANGE_FOLDER"
            android:targetClass="com.sitkatools.app.MainActivity"
            android:targetPackage="com.sitkatools.app" />
    </shortcut>
</shortcuts>
